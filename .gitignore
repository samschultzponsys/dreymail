# Modified by samschultzponsys, 2026-11-13: Android build output and signing keys.
# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Secrets and local configuration
.env
.env.*
!.env.example

# Local data (SQLite database, never commit)
data/
*.db
*.db-journal
*.sqlite
*.sqlite*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.log

# Android app build output (android/)
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.keystore
*.jks
