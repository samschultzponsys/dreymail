# Copy to .env and fill in real values. Never commit .env.
# dreymail .env.example: development only (deployments put variables inline in the compose file).
# Part of DreyMail, a modified version of Ratatoskr (https://github.com/magnuspihl/Ratatoskr); AGPL-3.0-only, see LICENSE and NOTICE.
# Modified by samschultzponsys, 2026-11-13: DREYMAIL_* variable names.

# Public URL the app is served from (used for OIDC redirects, cookies and WebSocket origin checks).
DREYMAIL_BASE_URL=https://mail.example.com

# Master key for encrypting stored account passwords and session cookies.
# At least 32 characters. Generate with: openssl rand -base64 48
# Changing it makes all stored account passwords unreadable (users must re-enter them).
DREYMAIL_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars

# Generic OpenID Connect provider (Authentik, Keycloak, ...).
# Redirect URI to register at the provider: ${DREYMAIL_BASE_URL}/auth/callback
OIDC_ISSUER_URL=https://auth.example.com/application/o/dreymail/
OIDC_CLIENT_ID=dreymail
OIDC_CLIENT_SECRET=change-me
# OIDC_SCOPES=openid email profile
# Provider name on the login button ("Sign in with Authentik").
# OIDC_LABEL=Authentik

# Username/password login. Defaults to true when OIDC_ISSUER_URL is not set, false when it is.
# DREYMAIL_PASSWORD_LOGIN=true
# Who may create a password account: open, first (only the first user of an empty instance), closed.
# DREYMAIL_REGISTRATION=first

# Starting values for new mail accounts; users can change them. Tokens: {username}, {email}, {name}.
# DREYMAIL_DEFAULT_IMAP_HOST=imap.example.com
# DREYMAIL_DEFAULT_IMAP_SECURITY=tls
# DREYMAIL_DEFAULT_IMAP_PORT=993
# DREYMAIL_DEFAULT_SMTP_HOST=smtp.example.com
# DREYMAIL_DEFAULT_SMTP_SECURITY=tls
# DREYMAIL_DEFAULT_SMTP_PORT=465
# DREYMAIL_DEFAULT_MAIL_USERNAME={username}@example.com
# DREYMAIL_DEFAULT_EMAIL={username}@example.com
# DREYMAIL_DEFAULT_DISPLAY_NAME={name}
# DREYMAIL_DEFAULT_ACCOUNT_LABEL=Mail
# Optional shared password (taken literally; only used for the default servers, never sent to browsers).
# DREYMAIL_DEFAULT_MAIL_PASSWORD=

# Set to true when running behind a reverse proxy that sets X-Forwarded-* headers.
# DREYMAIL_TRUST_PROXY=true

# Optional tuning
# PORT=8080
# DREYMAIL_DATA_DIR=./data
# DREYMAIL_BLOCK_PRIVATE_MAIL_HOSTS=false
# DREYMAIL_IMAP_IDLE_TIMEOUT=300
# DREYMAIL_MAX_MESSAGE_MB=50
# DREYMAIL_MAX_UPLOAD_MB=25
# Mail cache (encrypted copy of the newest INBOX and Sent mail, in cache.db): on/off and its size limits.
# DREYMAIL_CACHE=true
# DREYMAIL_CACHE_MESSAGES=2000
# DREYMAIL_CACHE_MAX_BODY_MB=1
# DREYMAIL_CACHE_ACCOUNT_MB=200
# Contact sent to push services with notifications (mailto: or https: URL).
# Defaults to DREYMAIL_BASE_URL when it is https.
# DREYMAIL_VAPID_SUBJECT=mailto:admin@example.com
# LOG_LEVEL=info

# Development only (ignored when NODE_ENV=production): log in without OIDC as a local dev user.
# DREYMAIL_DEV_LOGIN=true
# Development only (ignored in production and by the production build): also let the dev server
# answer on any host ending in this suffix, e.g. one reverse-proxied hostname per port
# (5173--myworkspace--me.dev.example.com, 40140--myworkspace--me.dev.example.com, ...).
# Must start with "." or "--". OIDC logins still return to DREYMAIL_BASE_URL.
# DREYMAIL_DEV_ALLOWED_HOST_SUFFIX=--myworkspace--me.dev.example.com
